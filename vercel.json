{
  "buildCommand": null,
  "outputDirectory": "docs",
  "functions": {
    "api/office-page.js": {
      "includeFiles": "api/_home-shell.html"
    },
    "api/home.js": {
      "includeFiles": "api/_home-shell.html"
    },
    "api/page.js": {
      "includeFiles": "api/_page-shell.html"
    },
    "api/og.js": {
      "includeFiles": "api/_og-fonts/**"
    },
    "api/national-desk.js": {
      "includeFiles": "api/_national-shell.html"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/api", "destination": "/api/api-not-found" },
    { "source": "/api/", "destination": "/api/api-not-found" },
    { "source": "/api/:path*", "destination": "/api/api-not-found" },
    { "source": "/o/:code", "destination": "/api/office-page?code=:code" },
    { "source": "/o/:code/", "destination": "/api/office-page?code=:code" },
    { "source": "/national", "destination": "/api/national-desk" },
    { "source": "/national/", "destination": "/api/national-desk" },
    { "source": "/about", "destination": "/api/page?slug=about" },
    { "source": "/about/", "destination": "/api/page?slug=about" },
    { "source": "/contact", "destination": "/api/page?slug=contact" },
    { "source": "/contact/", "destination": "/api/page?slug=contact" },
    { "source": "/privacy", "destination": "/api/page?slug=privacy" },
    { "source": "/privacy/", "destination": "/api/page?slug=privacy" },
    { "source": "/developers", "destination": "/api/page?slug=developers" },
    { "source": "/developers/", "destination": "/api/page?slug=developers" },
    { "source": "/", "destination": "/api/home" },
    { "source": "/:path((?!_vercel/).*)", "destination": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.weather.gov; img-src 'self' data:; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
