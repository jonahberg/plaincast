{
  "buildCommand": "cd shadcn && bun install && bun run build && cd .. && node scripts/prepare-deploy.mjs",
  "outputDirectory": "shadcn/dist",
  "functions": {
    "api/office-page.js": {
      "includeFiles": "api/_home-shell.html"
    },
    "api/home.js": {
      "includeFiles": "api/_home-shell.html"
    },
    "api/page.js": {
      "includeFiles": "api/_page-shell.html"
    },
    "api/og.js": {
      "includeFiles": "api/_og-fonts/**"
    },
    "api/national-desk.js": {
      "includeFiles": "api/_national-shell.html"
    },
    "api/cron-refresh.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron-refresh", "schedule": "*/5 * * * *" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "office", "value": "^(?<code>[Aa][Ll][Yy]|[Bb][Gg][Mm]|[Rr][Nn][Kk]|[Bb][Oo][Xx]|[Bb][Uu][Ff]|[Bb][Tt][Vv]|[Cc][Aa][Rr]|[Cc][Hh][Ss]|[Rr][Ll][Xx]|[Cc][Aa][Ee]|[Gg][Ss][Pp]|[Oo][Kk][Xx]|[Mm][Hh][Xx]|[Pp][Hh][Ii]|[Pp][Bb][Zz]|[Gg][Yy][Xx]|[Rr][Aa][Hh]|[Cc][Tt][Pp]|[Aa][Kk][Qq]|[Ll][Ww][Xx]|[Ii][Ll][Mm]|[Ff][Ff][Cc]|[Bb][Mm][Xx]|[Hh][Uu][Nn]|[Jj][Aa][Nn]|[Jj][Aa][Xx]|[Kk][Ee][Yy]|[Mm][Ll][Bb]|[Mm][Ee][Gg]|[Mm][Ff][Ll]|[Mm][Oo][Bb]|[Mm][Rr][Xx]|[Oo][Hh][Xx]|[Tt][Aa][Ee]|[Tt][Bb][Ww]|[Ii][Ll][Xx]|[Ll][Oo][Tt]|[Ii][Ll][Nn]|[Cc][Ll][Ee]|[Dd][Mm][Xx]|[Dd][Tt][Xx]|[Aa][Pp][Xx]|[Gg][Rr][Rr]|[Gg][Rr][Bb]|[Ii][Nn][Dd]|[Jj][Kk][Ll]|[Ee][Aa][Xx]|[Aa][Rr][Xx]|[Ll][Mm][Kk]|[Mm][Qq][Tt]|[Mm][Kk][Xx]|[Ii][Ww][Xx]|[Pp][Aa][Hh]|[Dd][Vv][Nn]|[Ss][Gg][Ff]|[Ll][Ss][Xx]|[Aa][Bb][Rr]|[Bb][Ii][Ss]|[Dd][Ll][Hh]|[Ff][Gg][Ff]|[Gg][Ii][Dd]|[Mm][Pp][Xx]|[Ll][Bb][Ff]|[Oo][Aa][Xx]|[Uu][Nn][Rr]|[Ff][Ss][Dd]|[Aa][Mm][Aa]|[Bb][Rr][Oo]|[Cc][Rr][Pp]|[Ff][Ww][Dd]|[Dd][Dd][Cc]|[Gg][Ll][Dd]|[Hh][Gg][Xx]|[Ll][Cc][Hh]|[Ll][Zz][Kk]|[Ll][Uu][Bb]|[Mm][Aa][Ff]|[Ll][Ii][Xx]|[Oo][Uu][Nn]|[Ss][Jj][Tt]|[Ee][Ww][Xx]|[Ss][Hh][Vv]|[Tt][Oo][Pp]|[Tt][Ss][Aa]|[Ii][Cc][Tt]|[Bb][Yy][Zz]|[Bb][Oo][Ii]|[Cc][Yy][Ss]|[Bb][Oo][Uu]|[Ll][Kk][Nn]|[Gg][Gg][Ww]|[Gg][Jj][Tt]|[Tt][Ff][Xx]|[Mm][Ss][Oo]|[Pp][Ii][Hh]|[Pp][Uu][Bb]|[Rr][Ee][Vv]|[Rr][Ii][Ww]|[Ss][Ll][Cc]|[Aa][Bb][Qq]|[Ee][Pp][Zz]|[Ff][Gg][Zz]|[Vv][Ee][Ff]|[Pp][Ss][Rr]|[Tt][Ww][Cc]|[Hh][Nn][Xx]|[Ee][Kk][Aa]|[Ll][Oo][Xx]|[Mm][Ff][Rr]|[Pp][Dd][Tt]|[Pp][Qq][Rr]|[Ss][Tt][Oo]|[Ss][Gg][Xx]|[Mm][Tt][Rr]|[Ss][Ee][Ww]|[Oo][Tt][Xx]|[Aa][Ff][Cc]|[Aa][Ff][Gg]|[Gg][Uu][Mm]|[Hh][Ff][Oo]|[Aa][Jj][Kk]|[Pp][Pp][Gg]|[Ss][Jj][Uu])$" }],
      "destination": "/o/:code/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/api", "destination": "/api/api-not-found" },
    { "source": "/api/", "destination": "/api/api-not-found" },
    { "source": "/api/:path*", "destination": "/api/api-not-found" },
    { "source": "/o/:code", "destination": "/api/office-page?code=:code" },
    { "source": "/o/:code/", "destination": "/api/office-page?code=:code" },
    { "source": "/national", "destination": "/api/national-desk" },
    { "source": "/national/", "destination": "/api/national-desk" },
    { "source": "/about", "destination": "/api/page?slug=about" },
    { "source": "/about/", "destination": "/api/page?slug=about" },
    { "source": "/contact", "destination": "/api/page?slug=contact" },
    { "source": "/contact/", "destination": "/api/page?slug=contact" },
    { "source": "/privacy", "destination": "/api/page?slug=privacy" },
    { "source": "/privacy/", "destination": "/api/page?slug=privacy" },
    { "source": "/developers", "destination": "/api/page?slug=developers" },
    { "source": "/developers/", "destination": "/api/page?slug=developers" },
    { "source": "/", "destination": "/api/home" },
    { "source": "/:path((?!_vercel/).*)", "destination": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.weather.gov; img-src 'self' data:; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
